---
    layout: 'base.njk'
---


<article class="note" data-pagefind-body>
<h1 class="note-title" id="top">{{ title or page.fileSlug }}</h1>
<p class="note-meta">
    {% if cdate %}<span>Posted {{ cdate | shortDate }}</span>{% endif %}
    {% if mdate %}<span>Modified {{ mdate | postDateNotes }}</span>{% endif %}
</p>
{% set toc = content | tableOfContents %}
{% if toc.length %}
<nav class="toc" aria-label="Contents">
<details class="toc-inner">
    <summary>Contents</summary>
    <ol>
        <li class="toc-depth-0"><a href="#top">(Top)</a></li>
        {% for item in toc %}
        <li class="toc-depth-{{ item.depth }}"><a href="#{{ item.id }}">{{ item.text }}</a></li>
        {% endfor %}
    </ol>
</details>
</nav>
{% endif %}
{% set infoImage = image | infoboxImage %}
{% if infoImage or info %}
<aside class="infobox">
<div class="infobox-inner">
    <div class="infobox-title">{{ title }}</div>
    {% if infoImage %}
    <figure>
        <img src="{{ infoImage }}" alt="{{ image_caption or title }}" loading="lazy">
        {% if image_caption %}<figcaption>{{ image_caption | inlineMarkdown | safe }}</figcaption>{% endif %}
    </figure>
    {% endif %}
    {% if info %}
    <table>
        {% for row in info | infoboxRows %}
        <tr>
            {% if row.label %}<th scope="row">{{ row.label }}</th><td>{{ row.value | inlineMarkdown | safe }}</td>
            {% else %}<td colspan="2">{{ row.value | inlineMarkdown | safe }}</td>{% endif %}
        </tr>
        {% endfor %}
    </table>
    {% endif %}
</div>
</aside>
{% endif %}

<div class="note-body">
    {{ content | citations | readingList | safe }}
    {% if references.length %}
    <section class="bibliography">
    <div class="bibliography-inner">
        <h2 class="refs-title" id="bibliography">Bibliography</h2>
        <dl class="references">
            {% for reference in references %}
            <div id="bib-{{ reference.id }}"{% if reference.missing %} class="missing"{% endif %}>
                <dt><a href="#bib-{{ reference.id }}" class="reference">{{ reference | bibliography_citation }}</a></dt>
                <dd>{{ reference | bibliography_entry({ doi_link: "id" }) | safe }}
                    {% if reference.citations.length %}
                    <small class="citation-links">
                        <em>Cited in</em>
                        {% for citation in reference.citations %}<a href="#ref-bib-{{ reference.id }}-{{ citation }}">{{ loop.index }}</a>{% if loop.revindex == 2 %} and{% elif not loop.last %},{% endif %} {% endfor %}
                    </small>
                    {% endif %}
                </dd>
            </div>
            {% endfor %}
        </dl>
    </div>
    </section>
    {% endif %}
</div>

<footer class="note-footer">
    <a href='mailto:sigmarootpi@proton.me?subject=Blogentry: {{ title }}'>Reply via email</a>
</footer>
</article>

{% if references.length %}
<script>
  // Wide screens: put each bibliography entry beside the line where it is first
  // cited, pushed down only as far as needed to clear the entry above it
  (function () {
    var section = document.querySelector(".bibliography");
    var entries = section.querySelectorAll("dl.references > div");
    var wide = window.matchMedia("(min-width: 1340px)");
    var gap = 12;

    function place() {
      var bottom = 0;
      entries.forEach(function (entry) {
        if (!wide.matches) { entry.style.top = ""; return; }
        var cite = document.querySelector('.note-body a.reference[href="#' + entry.id + '"]:not(.bibliography a)');
        var top = cite
          ? cite.getBoundingClientRect().top - section.getBoundingClientRect().top
          : bottom;
        top = Math.max(top, bottom);
        entry.style.top = top + "px";
        bottom = top + entry.offsetHeight + gap;
      });
    }
    place();
    wide.addEventListener("change", place);
    // Images, maths and fonts change where the citations end up
    new ResizeObserver(place).observe(document.querySelector(".note-body"));
  })();
</script>
{% endif %}

{% if toc.length %}
<script>
  // Contents: always open beside the text on wide screens, collapsed above it
  // otherwise; highlight the section currently being read
  (function () {
    var details = document.querySelector(".toc-inner");
    var wide = window.matchMedia("(min-width: 1340px)");
    function sync() { details.open = wide.matches; }
    sync();
    wide.addEventListener("change", sync);

    var links = {};
    document.querySelectorAll(".toc a").forEach(function (a) { links[a.hash.slice(1)] = a; });
    var targets = Object.keys(links).map(function (id) { return document.getElementById(id); }).filter(Boolean);
    function update() {
      var current = targets[0];
      targets.forEach(function (t) { if (t.getBoundingClientRect().top < 120) current = t; });
      Object.keys(links).forEach(function (id) { links[id].classList.toggle("active", current && id === current.id); });
    }
    document.addEventListener("scroll", update, { passive: true });
    update();
  })();
</script>
{% endif %}
