---
title: Notebooks
layout: 'base.njk'
---

<link href="/_pagefind/pagefind-ui.css" rel="stylesheet">

<style>
  @media (prefers-color-scheme: dark) {
    :root {
      --pagefind-ui-primary: #eeeeee;
      --pagefind-ui-text: #eeeeee;
      --pagefind-ui-background: #152028;
      --pagefind-ui-border: #152028;
      --pagefind-ui-tag: #152028;
    }
  }
</style>


<div id="search" class="search"></div>

<script src="/_pagefind/pagefind-ui.js"></script>
<script>
  // Start the search from ?q=… (used by the search box on the homepage)
  var searchUI = new PagefindUI({ element: "#search", showImages: false });
  var initialQuery = new URLSearchParams(location.search).get("q");
  if (initialQuery) searchUI.triggerSearch(initialQuery);
</script>